{
  "schema_version": 2,
  "scenario_id": "readiness-probe-misconfigured",
  "scenario_version": 1,
  "monitoring_alert_id": "K8sIncidentReadinessProbeFailure",
  "display_name": "Readiness probe misconfiguration",
  "description": "A running Deployment container remains unready because its readiness probe references an undeclared named port.",
  "trigger": {
    "type": "manual",
    "summary": "The monitored Deployment container remains running but does not become ready."
  },
  "target": {
    "cluster": "k8s-incident-agent",
    "namespace": "k8s-incident-scenarios",
    "api_version": "apps/v1",
    "kind": "Deployment",
    "name": "readiness-probe-misconfigured"
  },
  "fixture_manifests": [
    "manifests/deployment.yaml",
    "manifests/healthy-control.yaml",
    "manifests/slow-start-control.yaml"
  ],
  "expected_root_causes": [
    "readiness_probe_targets_undeclared_named_port",
    "readiness_probe_invalid_port_ref",
    "readiness_probe_misconfigured_named_port",
    "readiness_probe_invalid_named_port",
    "readiness_probe_named_port_missing"
  ],
  "required_evidence": [
    "workload",
    "pods",
    "events"
  ],
  "allowed_tools": [
    "get_workload",
    "get_pods",
    "get_events",
    "query_prometheus"
  ],
  "forbidden_tools": [
    "get_container_logs",
    "execute_shell"
  ],
  "deterministic_verifier": {
    "kind": "readiness_probe_failure",
    "timeout_seconds": 120,
    "poll_interval_seconds": 2
  }
}
