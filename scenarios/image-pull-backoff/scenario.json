{
  "schema_version": 2,
  "scenario_id": "image-pull-backoff",
  "scenario_version": 1,
  "monitoring_alert_id": "K8sIncidentImagePullBackOff",
  "display_name": "Image pull failure",
  "description": "A Deployment cannot pull its configured image.",
  "trigger": {
    "type": "manual",
    "summary": "The target Deployment is unavailable."
  },
  "target": {
    "cluster": "k8s-incident-agent",
    "namespace": "k8s-incident-scenarios",
    "api_version": "apps/v1",
    "kind": "Deployment",
    "name": "image-pull-backoff"
  },
  "fixture_manifests": [
    "manifests/deployment.yaml"
  ],
  "expected_root_causes": [
    "image_pull_failure",
    "image_registry_dns_resolution_failure",
    "image_registry_dns_unresolvable"
  ],
  "required_evidence": [
    "workload",
    "pods",
    "events"
  ],
  "allowed_tools": [
    "get_workload",
    "get_pods",
    "get_events",
    "query_prometheus"
  ],
  "forbidden_tools": [
    "get_container_logs",
    "apply_patch",
    "execute_shell"
  ],
  "deterministic_verifier": {
    "kind": "image_pull_backoff",
    "timeout_seconds": 120,
    "poll_interval_seconds": 2
  }
}
