{
  "schema_version": 2,
  "scenario_id": "pvc-binding-pending",
  "scenario_version": 1,
  "monitoring_alert_id": "K8sIncidentPersistentVolumeClaimPending",
  "display_name": "PVC binding pending",
  "description": "A PersistentVolumeClaim requests an immediate static StorageClass without an available PersistentVolume.",
  "trigger": {
    "type": "manual",
    "summary": "The monitored PersistentVolumeClaim remains Pending because no matching volume can bind."
  },
  "target": {
    "cluster": "k8s-incident-agent",
    "namespace": "k8s-incident-scenarios",
    "api_version": "v1",
    "kind": "PersistentVolumeClaim",
    "name": "pvc-binding-pending"
  },
  "fixture_manifests": [
    "manifests/persistent-volume-claim.yaml",
    "manifests/storage-class.yaml",
    "manifests/wffc-storage-class.yaml",
    "manifests/wffc-control.yaml"
  ],
  "expected_root_causes": [
    "persistent_volume_claim_unbound",
    "no_provisioner_and_no_prebound_pv",
    "no_matching_provisioner_plugin",
    "no_provisioner_no_volume_plugin",
    "no_provisioner_plugin"
  ],
  "required_evidence": [
    "pvc_storage"
  ],
  "allowed_tools": [
    "get_pvc_storage",
    "query_prometheus"
  ],
  "forbidden_tools": [
    "apply_patch",
    "execute_shell"
  ],
  "deterministic_verifier": {
    "kind": "pvc_pending",
    "timeout_seconds": 120,
    "poll_interval_seconds": 2
  }
}
