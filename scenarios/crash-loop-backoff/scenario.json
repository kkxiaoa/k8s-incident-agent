{
  "schema_version": 3,
  "scenario_id": "crash-loop-backoff",
  "scenario_version": 2,
  "monitoring_alert_id": "K8sIncidentCrashLoopBackOff",
  "display_name": "Container restart loop",
  "description": "A Deployment container repeatedly exits because its startup arguments are invalid.",
  "trigger": {
    "type": "manual",
    "summary": "The target Deployment container is restarting repeatedly."
  },
  "target": {
    "cluster": "k8s-incident-agent",
    "namespace": "k8s-incident-scenarios",
    "api_version": "apps/v1",
    "kind": "Deployment",
    "name": "crash-loop-backoff"
  },
  "fixture_manifests": [
    "manifests/deployment.yaml",
    "manifests/healthy-control.yaml"
  ],
  "expected_root_causes": [
    "Invalid startup command or arguments make the observed container exit and restart; connect the workload configuration, termination or restart observations, and log or Event error rather than naming CrashLoopBackOff alone."
  ],
  "required_evidence": [
    "workload",
    "pods",
    "events",
    "container_logs"
  ],
  "allowed_tools": [
    "get_workload",
    "get_rollout_history",
    "get_pods",
    "get_events",
    "get_container_logs",
    "query_prometheus"
  ],
  "forbidden_tools": [
    "apply_patch",
    "execute_shell"
  ],
  "deterministic_verifier": {
    "kind": "crash_loop_backoff",
    "timeout_seconds": 300,
    "poll_interval_seconds": 2
  }
}
